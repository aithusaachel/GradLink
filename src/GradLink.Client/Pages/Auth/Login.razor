@page "/login"
@page "/register"
@page "/signup"
@inject NavigationManager Navigation
@inject ApiClient Api
@inject LocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@using GradLink.Shared.Enums
@using GradLink.Shared.DTOs

<div class="auth-page-wrapper">
    <div class="auth-container">
        
        <!-- LEFT: PURPLE BRAND SHOWCASE CARD -->
        <div class="auth-brand-card">
            <div class="auth-brand-bg-circle"></div>
            <div class="auth-brand-bg-ring"></div>

            <div class="auth-brand-top">
                <div class="auth-brand-logo">
                    <div class="auth-logo-badge">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                            <rect width="24" height="24" rx="6" fill="#5B4DF5" />
                            <path d="M6 9.5h12M6 14.5h7" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <span class="auth-logo-text">GradLink</span>
                </div>
            </div>

            <div class="auth-brand-body">
                <div class="auth-pill-badge">
                    <Icon Name="sparkles" Size="14" />
                    <span>Your career, connected</span>
                </div>
                <h2 class="auth-brand-headline">
                    Find the people and opportunities that move you forward.
                </h2>
                <p class="auth-brand-subtext">
                    One thoughtful place for graduates to build their careers and employers to discover emerging talent.
                </p>
            </div>

            <div class="auth-brand-footer">
                <div class="auth-avatar-stack">
                    <div class="auth-avatar-circle auth-avatar-1">AM</div>
                    <div class="auth-avatar-circle auth-avatar-2">TC</div>
                    <div class="auth-avatar-circle auth-avatar-3">LP</div>
                </div>
                <div class="auth-social-text">
                    <span class="auth-social-count">8,400+ graduates</span>
                    <span class="auth-social-desc">already building their next chapter</span>
                </div>
            </div>
        </div>

        <!-- RIGHT: AUTHENTICATION FORM CARD -->
        <div class="auth-form-card">
            <div class="auth-header">
                <span class="auth-eyebrow">@(_isRegister ? "JOIN GRADLINK" : "WELCOME BACK")</span>
                <h1 class="auth-title">@(_isRegister ? "Create your account" : "Sign in to your account")</h1>
                <p class="auth-subtitle">@(_isRegister ? "Choose how you’ll use GradLink to get started." : "Pick up where you left off.")</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="auth-error-banner" role="alert">
                    <Icon Name="x" Size="16" />
                    <span>@_errorMessage</span>
                </div>
            }

            <!-- Role Selector -->
            <div class="auth-role-section">
                <label class="auth-label">I'm joining as</label>
                <RoleSelector TValue="string"
                              Value="_selectedRole"
                              ValueChanged="SelectRole"
                              Options="GetRoleOptions()" />
            </div>

            <form class="auth-form" @onsubmit="HandleSubmit">
                @if (_isRegister)
                {
                    <div class="form-group">
                        <AppInput Label="Full name"
                                  Placeholder="Enter your full name"
                                  @bind-Value="_name"
                                  Required="true"
                                  Autocomplete="name" />
                    </div>
                }

                <div class="form-group">
                    <AppInput Label="Email address"
                              Placeholder="you@example.com"
                              Type="email"
                              @bind-Value="_email"
                              Required="true"
                              Autocomplete="email" />
                </div>

                <div class="form-group">
                    <AppInput Label="Password"
                              Placeholder="@(_isRegister ? "Create a secure password" : "Enter your password")"
                              Type="password"
                              @bind-Value="_password"
                              Required="true"
                              Autocomplete="@(_isRegister ? "new-password" : "current-password")" />
                    
                    @if (!_isRegister)
                    {
                        <div class="forgot-password-row">
                            <button type="button" class="forgot-password-link" @onclick="ForgotPasswordPrompt">Forgot password?</button>
                        </div>
                    }
                </div>

                <div class="auth-submit-row">
                    <AppButton Type="submit"
                               Variant="primary"
                               IsFullWidth="true"
                               IsLoading="_isLoading">
                        <div class="auth-btn-stacked">
                            <span>@(_isRegister ? $"Create {_selectedRole.ToLowerInvariant()} account" : $"Sign in as a {_selectedRole.ToLowerInvariant()}")</span>
                            <span class="auth-btn-arrow">→</span>
                        </div>
                    </AppButton>
                </div>
            </form>

            <div class="auth-footer-links">
                <p class="auth-toggle-prompt">
                    @if (_isRegister)
                    {
                        <span>Already have an account?</span>
                        <button type="button" class="auth-link-button" @onclick="ToggleMode">Sign in</button>
                    }
                    else
                    {
                        <span>New to GradLink?</span>
                        <button type="button" class="auth-link-button" @onclick="ToggleMode">Create an account</button>
                    }
                </p>
                <p class="auth-terms">
                    By continuing, you agree to GradLink's Terms of Service and Privacy Policy.
                </p>
            </div>
        </div>

    </div>
</div>

@code {
    private bool _isRegister = false;
    private bool _isLoading = false;
    private string _selectedRole = "Graduate";
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        var uri = Navigation.Uri.ToLowerInvariant();
        if (uri.Contains("/register") || uri.Contains("/signup"))
        {
            _isRegister = true;
        }
    }

    private void ToggleMode()
    {
        _isRegister = !_isRegister;
        _errorMessage = null;
        Navigation.NavigateTo(_isRegister ? "/signup" : "/login", replace: false);
    }

    private void SelectRole(string role)
    {
        _selectedRole = role;
    }

    private void ForgotPasswordPrompt()
    {
        _errorMessage = "Password reset instructions have been dispatched to your email if registered.";
    }

    private List<RoleOption<string>> GetRoleOptions()
    {
        return new List<RoleOption<string>>
        {
            new()
            {
                Value = "Graduate",
                Label = "Graduate",
                Description = "Find roles and manage applications",
                Icon = @<Icon Name="user" Size="20" />,
                IconBgColor = "#EDE9FE",
                IconColor = "#5B4DF5"
            },
            new()
            {
                Value = "Employer",
                Label = "Employer",
                Description = "Post jobs and discover talent",
                Icon = @<Icon Name="building" Size="20" />,
                IconBgColor = "#ECFDF5",
                IconColor = "#059669"
            }
        };
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            if (_isRegister)
            {
                var registerModel = new RegisterDto
                {
                    Email = _email,
                    Password = _password,
                    FullName = _name,
                    Role = _selectedRole == "Employer" ? UserRole.Employer : UserRole.Graduate,
                    CompanyName = _selectedRole == "Employer" ? _name : null
                };

                var regResult = await Api.RegisterAsync(registerModel);
                if (regResult == null || !regResult.Success)
                {
                    _errorMessage = regResult?.Message ?? "Registration failed. Please check your details.";
                    return;
                }
            }

            var model = new LoginDto { Email = _email, Password = _password };
            var result = await Api.LoginAsync(model);
            if (result != null && result.Success)
            {
                await LocalStorage.SetItemAsync("authToken", result.Token!);
                ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserAuthentication(result.Token!);

                var state = await AuthStateProvider.GetAuthenticationStateAsync();
                var isEmployer = state.User.IsInRole("Employer");

                if (isEmployer)
                    Navigation.NavigateTo("/employer/dashboard");
                else
                    Navigation.NavigateTo("/graduate/dashboard");
            }
            else
            {
                _errorMessage = result?.Message ?? "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An error occurred during authentication. " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
