@page "/employer/applicants"
@layout GradLink.Client.Layout.EmployerLayout

<PageTitle>Applicants – Gradly Employer</PageTitle>

<div class="e-head">
  <div><h1>Applicant pipeline</h1><p>Review candidates and keep your hiring process moving.</p></div>
  <button class="e-btn"><svg class="ico" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/></svg> Talent pool</button>
</div>

<div class="e-board">
  @foreach (var (key, label) in columns)
  {
    var list = people.Where(p => p.Status == key).ToList();
    <section class="e-col">
      <h3>@label <span class="e-count">@list.Count</span></h3>
      @foreach (var p in list)
      {
        <article class="e-acard">
          <div class="e-avatar @p.Tone">@p.Initials</div>
          <b>@p.Name</b>
          <small>@p.Role · @p.Match% match</small>
          <div class="e-foot">
            <span class="pill @(key == "new" ? "portfolio" : key)">@p.Tag</span>
            <small>@p.When</small>
          </div>
        </article>
      }
    </section>
  }
</div>

@code {
  record Applicant(string Name, string Initials, string Role, int Match, string Status, string Tag, string When, string Tone);

  (string, string)[] columns = { ("new", "New"), ("review", "In review"), ("interview", "Interview") };

  // Status = "new" | "review" | "interview"  (change it to move a card between columns)
  // TODO: load from GradLink.API
  List<Applicant> people = new() {
    new("Maya Chen", "MC", "Product Designer", 94, "new", "Portfolio", "2d ago", "c-purple"),
    new("Jordan Ellis", "JE", "Product Designer", 91, "new", "Portfolio", "2d ago", "c-red"),
    new("Aisha Patel", "AP", "Product Designer", 88, "new", "Portfolio", "2d ago", "c-green"),
    new("Theo James", "TJ", "Frontend Engineer", 91, "review", "Review", "3d ago", "c-green"),
    new("Lena Fischer", "LF", "Frontend Engineer", 87, "review", "Review", "3d ago", "c-blue"),
    new("Sam King", "SK", "Product Designer", 89, "interview", "Fri, 10:30", "Video", "c-yellow") };
}
