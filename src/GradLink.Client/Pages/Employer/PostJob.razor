@page "/employer/jobs"
@layout GradLink.Client.Layout.EmployerLayout

<PageTitle>Posted jobs – Gradly Employer</PageTitle>

<div class="e-head">
  <div><h1>Posted jobs</h1><p>Create, publish and manage every open role.</p></div>
  <button class="e-btn" @onclick="() => showForm = !showForm"><span style="font-size:18px;line-height:1">+</span> Create job</button>
</div>

@if (showForm)
{
  <div class="e-card e-form">
    <h3>New job</h3><span class="sub">Jobs with salary ranges get 34% more applications.</span>
    <div class="e-fields">
      <label>Job title<input @bind="title" placeholder="e.g. Junior Data Analyst" /></label>
      <label>Location<input @bind="location" placeholder="e.g. Accra, Ghana" /></label>
      <label>Salary range<input @bind="salary" placeholder="e.g. GHS 4,000 – 6,000" /></label>
      <label>Closing date<input type="date" @bind="closes" /></label>
    </div>
    <label style="margin-top:16px">Description<textarea @bind="description"></textarea></label>
    <div style="display:flex;gap:10px;margin-top:18px">
      <button class="e-btn" @onclick='() => Save("Live")'>Publish</button>
      <button class="e-ghost" @onclick='() => Save("Draft")'>Save as draft</button>
    </div>
  </div>
}

<div class="e-card e-table">
  <div class="e-trow th"><span>Job</span><span>Applicants</span><span>Status</span><span></span></div>
  @foreach (var j in jobs)
  {
    <a class="e-trow" href="/employer/applicants">
      <div class="job">
        <div class="jicon @j.Tone"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18"/></svg></div>
        <div><b>@j.Title</b><small>@j.Posted</small></div>
      </div>
      <span style="font-size:13px;color:#555a65">@j.Applicants applicants</span>
      <span><span class="pill @j.Status.ToLower()">@j.Status</span></span>
      <span style="justify-self:end">→</span>
    </a>
  }
</div>

@code {
  record Job(string Title, string Posted, int Applicants, string Status, string Tone);

  bool showForm;
  string title = "", location = "", salary = "", description = "";
  DateTime? closes;

  // TODO: load/save through GradLink.API
  List<Job> jobs = new() {
    new("Junior Product Designer", "Posted 2 days ago", 32, "Live", "c-purple"),
    new("Graduate Frontend Engineer", "Posted 5 days ago", 28, "Live", "c-blue"),
    new("Marketing Associate", "Posted 8 days ago", 17, "Live", "c-red"),
    new("Data Analyst", "Posted 11 days ago", 9, "Draft", "c-green") };

  void Save(string status)
  {
    if (string.IsNullOrWhiteSpace(title)) return;
    jobs.Insert(0, new Job(title, "Posted just now", 0, status, "c-yellow"));
    title = location = salary = description = "";
    showForm = false;
  }
}
