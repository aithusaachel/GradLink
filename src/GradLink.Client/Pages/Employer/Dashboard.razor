@page "/employer/dashboard"
@layout GradLink.Client.Layout.AppLayout
@inject ApiClient Api

@if (_isLoading)
{
    <div class="p-48 text-center text-body color-secondary">Loading...</div>
}
else
{
    <div class="mb-64 mt-48">
        <h1 class="text-display mb-8">@_stats?.TotalApplicants</h1>
        <p class="text-h3 color-secondary">Total Applicants</p>
    </div>

    <section>
        <div class="flex items-center justify-between mb-24">
            <h2 class="text-h2">Active Postings</h2>
            <a href="/employer/jobs/new" style="color: var(--color-accent); font-weight: 500;">Post new</a>
        </div>

        <div class="flex flex-col">
            @if (_activeJobs != null)
            {
                foreach (var job in _activeJobs)
                {
                    <a href="/employer/jobs/@job.Id/applicants" class="ios-list-item">
                        <div class="flex flex-col gap-8">
                            <h3 class="text-h3">@job.Title</h3>
                            <div class="flex items-center gap-16 color-secondary">
                                <span class="flex items-center gap-4"><Icon Name="users" Size="16" /> @job.ApplicationCount applicants</span>
                                <span class="flex items-center gap-4"><Icon Name="clock" Size="16" /> Posted @((int)(DateTime.UtcNow - job.PostedDate).TotalDays)d ago</span>
                            </div>
                        </div>
                        <Icon Name="chevron-right" Size="20" CssClass="color-secondary" />
                    </a>
                }
            }
        </div>
    </section>
}

@code {
    private bool _isLoading = true;
    private DashboardStatsDto? _stats;
    private List<JobListingDto>? _activeJobs;

    protected override async Task OnInitializedAsync()
    {
        _stats = await Api.GetDashboardStatsAsync();
        _activeJobs = await Api.GetEmployerJobsAsync();
        _isLoading = false;
    }
}
