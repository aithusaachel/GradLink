@page "/employer/profile"
@layout GradLink.Client.Layout.EmployerLayout

<PageTitle>Company profile – GradLink Employer</PageTitle>

<div class="e-banner">
  <div class="e-who">
    <div class="e-logolg">NL</div>
    <div><h2>@name</h2><p>Product software · London, UK</p></div>
  </div>
  <button class="e-ghost" @onclick="Save">@(saved ? "Saved ✓" : "Save changes")</button>
</div>

<div class="e-pgrid">
  <div>
    <div class="e-card e-form">
      <h3>Company information</h3>
      <span class="sub">Keep your profile accurate so candidates know who you are.</span>
      <div class="e-fields">
        <label>Company name<input @bind="name" /></label>
        <label>Industry<input @bind="industry" /></label>
        <label>Location<input @bind="location" /></label>
        <label>Company size
          <select @bind="size">
            <option>1–10 employees</option><option>11–50 employees</option>
            <option>51–200 employees</option><option>200+ employees</option>
          </select>
        </label>
      </div>
    </div>
    <div class="e-card e-form">
      <h3 style="margin-bottom:20px">About your company</h3>
      <label><textarea @bind="about"></textarea></label>
    </div>
  </div>

  <div class="e-card e-form">
    <h3 style="margin-bottom:20px">Company profile</h3>
    <div class="e-assets">
      <div class="jicon"><svg class="ico" viewBox="0 0 24 24"><path d="M5 21V4a1 1 0 011-1h9a1 1 0 011 1v17M16 9h3a1 1 0 011 1v11M3 21h18M9 8h3M9 12h3M9 16h3"/></svg></div>
      <b>Brand assets</b><small>Logo and cover uploaded</small>
      <button class="e-ghost" @onclick="ToggleAssetManager" aria-expanded="@assetManagerOpen">
        @(assetManagerOpen ? "Close asset manager" : "Manage assets")
      </button>
      @if (assetManagerOpen)
      {
        <div class="e-assets-status" role="status">Asset manager opened. Logo and cover controls are ready.</div>
      }
    </div>
  </div>
</div>

@code {
  string name = "Northstar Labs", industry = "Software & technology", location = "London, United Kingdom",
         size = "51–200 employees", about = "We build calm, thoughtful software for creative teams.";
  bool saved;
    bool assetManagerOpen;

  // TODO: send to GradLink.API
  void Save() => saved = true;
  void ToggleAssetManager() => assetManagerOpen = !assetManagerOpen;
}
