        align-items: center;
        justify-content: center;
        margin-bottom: 8px;
    }
    .success-modal-heading {
        font-size: 20px;
        font-weight: 800;
        color: #111827;
        margin: 0;
    }
    .success-modal-text {
        font-size: 14px;
        color: #4B5563;
        line-height: 1.5;
        margin: 0;
    }
    .success-modal-subtext {
        font-size: 12px;
        color: #6B7280;
        background-color: #F9FAFB;
        padding: 10px 14px;
        border-radius: 10px;
        margin-top: 8px;
    }

    .submit-app-btn:active:not(:disabled) {
        transform: scale(0.98);
    }
    .bookmark-action-btn:active {
        transform: scale(0.94);
    }

    @@media (max-width: 900px) {
        .job-content-grid {
            grid-template-columns: 1fr;
        }
        .job-right-column {
            position: relative;
            top: 0;
        }
        .job-hero-card {
            flex-direction: column;
            padding: 24px;
        }
