    }

    .cv-status-box {
        background-color: #F9FAFB;
        border: 1px solid #ECEEF2;
        border-radius: 12px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cv-status-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background-color: #EEF2FF;
        color: #4F46E5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
