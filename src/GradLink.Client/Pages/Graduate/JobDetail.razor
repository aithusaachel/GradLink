    .cv-status-name {
        font-size: 13px;
        font-weight: 700;
        color: #111827;
    }

    .cv-status-verified {
        font-size: 11px;
        color: #059669;
        font-weight: 500;
    }

    .cover-letter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cover-letter-label {
        font-size: 12px;
        font-weight: 600;
        color: #374151;
