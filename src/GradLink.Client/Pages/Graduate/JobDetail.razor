    }

    .apply-card-title {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .apply-card-subtitle {
        font-size: 13px;
        color: #6B7280;
        margin: -10px 0 4px 0;
    }

    .applied-status-banner {
        background-color: #ECFDF5;
        border: 1px solid #A7F3D0;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .applied-check-icon {
        width: 32px;
        height: 32px;
        background-color: #10B981;
        color: #FFFFFF;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .applied-status-title {
        font-size: 14px;
        font-weight: 700;
        color: #065F46;
    }

    .applied-status-desc {
        font-size: 12px;
        color: #047857;
    }

    .view-apps-link-btn {
        background-color: #111827;
        color: #FFFFFF;
        padding: 12px;
        border-radius: 999px;
        text-align: center;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background-color var(--ease-standard);
