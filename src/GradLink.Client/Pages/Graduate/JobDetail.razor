@page "/graduate/jobs/{Id:int}"
@layout GradLink.Client.Layout.AppLayout
@inject ApiClient Api
@inject NavigationManager Navigation
@using GradLink.Shared.DTOs
@using GradLink.Shared.Enums

@if (_isLoading)
{
    <div class="py-64 flex items-center justify-center">
        <AppLoadingState Message="Loading role details..." />
    </div>
}
else if (_job != null)
{
    <div class="job-detail-container">
        <!-- Back Link Navigation -->
        <div class="back-nav-row">
            <a href="/graduate/jobs" class="back-link">
                <span class="back-arrow" aria-hidden="true"><Icon Name="chevron-left" Size="16" /></span>
                <span>Back to jobs</span>
            </a>
        </div>

        <!-- Alert messages -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert-box alert-error">
                <Icon Name="x" Size="16" />
                <span>@_errorMessage</span>
            </div>
        }

        <!-- Top Header Card -->
        <div class="job-hero-card">
            <div class="job-hero-main">
                <div class="job-company-avatar" style="background-color: @_avatarBg; color: @_avatarColor;">
                    @_companyInitial
                </div>

                <div class="job-header-text">
                    <div class="job-company-title-row">
                        <span class="job-company-name">@_job.CompanyName</span>
                        <span class="website-bullet">·</span>
                        <span class="verified-employer-tag">Verified Employer ✓</span>
                    </div>

                    <h1 class="job-role-headline">@_job.Title</h1>

                    <div class="job-meta-chips">
                        <span class="meta-chip">
                            <Icon Name="map-pin" Size="14" />
                            <span>@_job.Location</span>
                        </span>

                        <span class="meta-chip">
                            <Icon Name="briefcase" Size="14" />
                            <span>@(!string.IsNullOrWhiteSpace(_job.Industry) ? _job.Industry : "Technology")</span>
                        </span>

                        <span class="meta-chip">
                            <Icon Name="clock" Size="14" />
                            <span>Posted @GetTimeAgoText()</span>
                        </span>

                        @if (!string.IsNullOrWhiteSpace(_job.SalaryRange))
                        {
                            <span class="meta-chip salary-chip">
                                <span>@_job.SalaryRange</span>
                            </span>
                        }

                        <span class="match-badge-chip">96% match</span>
                    </div>
                </div>
            </div>

            <button class="bookmark-action-btn @(_isBookmarked ? "bookmarked" : "")" 
                    @onclick="ToggleBookmark" 
                    title="Bookmark this job">
                <Icon Name="bookmark" Size="20" />
            </button>
        </div>

        <!-- Two Column Content Grid -->
        <div class="job-content-grid">
            <!-- Left Column: Description, Responsibilities, Requirements -->
            <div class="job-left-column">
                <!-- About the Role -->
                <div class="content-section-card">
                    <h2 class="section-heading">About the role</h2>
                    <div class="section-prose">
                        @if (!string.IsNullOrWhiteSpace(_job.Description))
                        {
                            <p>@_job.Description</p>
                        }
                        else
                        {
                            <p>
                                We are looking for an ambitious, creative individual to join our growing team. You will collaborate directly with senior leaders, tackle real-world problems, and make a tangible impact across our core product and engineering efforts.
                            </p>
                        }

                        <p>
                            In this position, you'll be part of an inclusive, high-velocity team that values craftsmanship, rapid learning, and thoughtful user experience. We invest heavily in our graduates with structured mentorship, weekly 1-on-1s, and a generous learning budget.
                        </p>
                    </div>
                </div>

                <!-- What You'll Do -->
                <div class="content-section-card">
                    <h2 class="section-heading">What you'll do</h2>
                    <ul class="bullet-list">
                        <li>Partner with cross-functional teammates to design, build, and deliver high-impact features.</li>
                        <li>Contribute to user research, requirements gathering, and iterative prototyping.</li>
                        <li>Maintain quality and clean architecture through testing, code reviews, and design audits.</li>
                        <li>Present insights, findings, and demos to team members and key stakeholders.</li>
                    </ul>
                </div>

                <!-- What We're Looking For -->
                <div class="content-section-card">
                    <h2 class="section-heading">What we're looking for</h2>
                    <ul class="bullet-list">
                        <li>Graduated or graduating in 2025/2026 in Computer Science, Design, Engineering, or a related discipline.</li>
                        <li>Curiosity to learn new technologies and frameworks quickly.</li>
                        <li>Clear communication skills and a team-first mindset.</li>
                        <li>A portfolio, project, or GitHub profile showcasing practical work or passion projects.</li>
                    </ul>
                </div>
            </div>

            <!-- Right Column: Sticky Application Widget -->
            <div class="job-right-column">
                <div class="apply-card">
                    <h3 class="apply-card-title">Apply for this role</h3>
                    <p class="apply-card-subtitle">Submit your application directly to the hiring team.</p>

                    @if (_hasApplied)
                    {
                        <div class="applied-status-banner">
                            <div class="applied-check-icon">
                                <Icon Name="check" Size="18" />
                            </div>
                            <div class="applied-status-info">
                                <div class="applied-status-title">Application Submitted!</div>
                                <div class="applied-status-desc">Status: <strong>@_applicationStatus</strong></div>
                            </div>
                        </div>

                        <a href="/graduate/applications" class="view-apps-link-btn">
                            <span>Track in My Applications</span>
                            <Icon Name="chevron-right" Size="16" />
                        </a>
                    }
                    else
                    {
                        <!-- CV Status Indicator -->
                        <div class="cv-status-box">
                            <div class="cv-status-icon">
                                <Icon Name="briefcase" Size="16" />
                            </div>
                            <div class="cv-status-text">
                                <div class="cv-status-name">@_cvFileName</div>
                                <div class="cv-status-verified">✓ Attached from your profile</div>
                            </div>
                        </div>

                        <!-- Cover Letter Field -->
                        <div class="cover-letter-group">
                            <label class="cover-letter-label">Cover note (optional)</label>
                            <textarea class="cover-letter-textarea" 
                                      rows="4" 
                                      placeholder="Share why you're interested in this role and what makes you a great match..."
                                      @bind="_coverLetter"></textarea>
                        </div>

                        <!-- Submit Application Button -->
                        <button class="submit-app-btn @(_isApplying ? "loading" : "")" 
                                @onclick="SubmitApplication" 
                                disabled="@_isApplying">
                            @if (_isApplying)
                            {
                                <span class="btn-spinner"></span>
                                <span>Submitting application...</span>
                            }
                            else
                            {
                                <span>Submit application</span>
                                <span class="submit-arrow" aria-hidden="true"><Icon Name="chevron-right" Size="18" /></span>
                            }
                        </button>

                        <div class="apply-guarantee">
                            <Icon Name="check" Size="14" />
                            <span>100% verified employer on Gradly</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Application Success Modal -->
@if (_showSuccessModal)
{
    <AppModal Title="Application Sent!" IsOpen="true" OnClose="CloseSuccessModal">
        <ChildContent>
            <div class="success-modal-body">
                <div class="success-icon-badge">
                    <Icon Name="check" Size="28" />
                </div>
                <h3 class="success-modal-heading">You're all set!</h3>
                <p class="success-modal-text">
                    Your application for <strong>@_job?.Title</strong> at <strong>@_job?.CompanyName</strong> has been sent to the employer.
                </p>
                <div class="success-modal-subtext">
                    You will receive real-time notifications via SignalR as the status of your application updates.
                </div>
            </div>
        </ChildContent>
        <Footer>
            <AppButton Variant="secondary" Text="Back to jobs" OnClick="NavigateToJobs" />
            <AppButton Variant="primary" Text="View applications" OnClick="NavigateToApplications" />
        </Footer>
    </AppModal>
}

