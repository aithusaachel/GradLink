@if (IsOpen)
{
    <div class="app-modal-backdrop" tabindex="-1" @onclick="Close" @onkeydown="HandleKeyDown">
        <div class="app-modal" role="dialog" aria-modal="true"
             aria-labelledby="@(string.IsNullOrWhiteSpace(Title) ? null : "modal-title")"
             aria-label="@(string.IsNullOrWhiteSpace(Title) ? "Dialog" : null)"
             tabindex="-1" @ref="modalElement" @onclick:stopPropagation @onkeydown="HandleKeyDown">
            @if (ShowHeader)
            {
                <div class="app-modal-header">
                    <div class="app-modal-title-wrap">
                        @if (!string.IsNullOrWhiteSpace(Title))
                        {
                            <h3 id="modal-title" class="app-modal-title">@Title</h3>
                        }

                        @if (!string.IsNullOrWhiteSpace(SubTitle))
                        {
                            <p class="app-modal-subtitle">@SubTitle</p>
                        }
                    </div>

                    @if (ShowCloseButton)
                    {
                        <button type="button" class="app-modal-close" aria-label="Close dialog" @onclick="Close">
                            ×
                        </button>
                    }
                </div>
            }

            <div class="app-modal-body">
                @ChildContent
            </div>

            @if (Footer is not null)
            {
                <div class="app-modal-footer">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SubTitle { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference modalElement;
    private bool focusPending;
    private bool wasOpen;

    protected override void OnParametersSet()
    {
        focusPending = IsOpen && !wasOpen;
        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPending)
        {
            focusPending = false;
            await modalElement.FocusAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            await Close();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
