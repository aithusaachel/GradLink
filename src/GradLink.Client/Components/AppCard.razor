<div class="app-card @(Hoverable ? "hoverable" : "") @(Padding ? "with-padding" : "") @CssClass" 
     style="@Style"
    role="@(Hoverable && OnClick.HasDelegate ? "button" : null)"
    tabindex="@(Hoverable && OnClick.HasDelegate ? "0" : null)"
    @onclick="HandleClick"
    @onkeydown="HandleKeyDown">
    @ChildContent
</div>


@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Hoverable { get; set; }
    [Parameter] public bool Padding { get; set; } = true;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    private async Task HandleClick()
    {
        if (Hoverable && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            await HandleClick();
    }
}
