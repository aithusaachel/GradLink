<div class="app-dropdown @CssClass" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="app-dropdown-label">@Label</label>
    }

    <button type="button"
            class="app-dropdown-control @(IsOpen ? "open" : "")"
            aria-haspopup="listbox"
            aria-expanded="@IsOpen"
            aria-controls="@MenuId"
            @onclick="ToggleOpen"
            @onkeydown="HandleControlKeyDown">
        <span class="app-dropdown-value">@SelectedText</span>
        <Icon Name="chevron-down" Size="18" />
    </button>

    @if (IsOpen)
    {
        <div id="@MenuId" class="app-dropdown-menu" role="listbox" aria-label="@Label">
            @foreach (var option in Options)
            {
                var isSelected = option.Value.Equals(CurrentValue, StringComparison.Ordinal);

                <button type="button"
                        class="app-dropdown-option @(isSelected ? "selected" : "")"
                        role="option"
                        aria-selected="@isSelected"
                        @onclick="() => Select(option)">
                    @option.Text
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public List<AppDropdownOption> Options { get; set; } = new();
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool IsOpen { get; set; }
    private string MenuId { get; } = $"app-dropdown-menu-{Guid.NewGuid():N}";

    private string CurrentValue => Value;

    private string SelectedText => Options.FirstOrDefault(o => o.Value.Equals(CurrentValue, StringComparison.Ordinal))?.Text ?? "Select an option";

    private void ToggleOpen()
    {
        IsOpen = !IsOpen;
    }

    private void HandleControlKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            IsOpen = false;
        else if (args.Key is "Enter" or " " or "ArrowDown")
            IsOpen = true;
    }

    private async Task Select(AppDropdownOption option)
    {
        IsOpen = false;
        await ValueChanged.InvokeAsync(option.Value);
    }
}
