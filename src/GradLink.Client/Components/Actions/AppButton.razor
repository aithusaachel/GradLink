<button class="app-button app-button-@Variant @((FullWidth || IsFullWidth) ? "full-width" : "") @(IsDisabled || IsLoading ? "is-disabled" : "") @CssClass"
        style="@Style"
        type="@Type"
        disabled="@(IsDisabled || IsLoading)"
        @onclick="HandleClick">
    @if (IsLoading)
    {
        <span class="button-spinner" aria-hidden="true"></span>
    }
    else
    {
        @if (LeadingIcon is not null)
        {
            <span class="button-icon">@LeadingIcon</span>
        }
    }

    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <span class="button-text">@Text</span>
    }
    else if (ChildContent is not null)
    {
        <span class="button-text">@ChildContent</span>
    }

    @if (ShowArrow && !IsLoading)
    {
        <span class="button-arrow" aria-hidden="true">→</span>
    }
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? LeadingIcon { get; set; }
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool IsFullWidth { get; set; }
    [Parameter] public bool ShowArrow { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (!IsDisabled && !IsLoading)
        {
            await OnClick.InvokeAsync(args);
        }
    }
}
