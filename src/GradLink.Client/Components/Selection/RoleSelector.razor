@typeparam TValue

<div class="role-selector @CssClass">
    @foreach (var option in Options)
    {
        var isSelected = EqualityComparer<TValue>.Default.Equals(option.Value, Value);

        <button type="button"
                class="role-option @(isSelected ? "selected" : "")"
                aria-pressed="@isSelected"
                @onclick="() => Select(option.Value)">
            <div class="role-option-content">
                @if (option.Icon is not null)
                {
                    <div class="role-option-icon-box" style="@(!string.IsNullOrEmpty(option.IconBgColor) ? $"background-color: {option.IconBgColor}; color: {option.IconColor ?? "inherit"};" : "")">
                        @option.Icon
                    </div>
                }

                <div class="role-option-text">
                    <span class="role-option-label">@option.Label</span>
                    @if (!string.IsNullOrWhiteSpace(option.Description))
                    {
                        <span class="role-option-description">@option.Description</span>
                    }
                </div>
            </div>

            <div class="role-option-indicator @(isSelected ? "selected" : "")">
                @if (isSelected)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                }
            </div>
        </button>
    }
</div>

@code {
    [Parameter] public IEnumerable<RoleOption<TValue>> Options { get; set; } = new List<RoleOption<TValue>>();
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string CssClass { get; set; } = "";

    private async Task Select(TValue selectedValue)
    {
        if (EqualityComparer<TValue>.Default.Equals(Value, selectedValue))
        {
            return;
        }

        Value = selectedValue;
        await ValueChanged.InvokeAsync(selectedValue);
    }
}
