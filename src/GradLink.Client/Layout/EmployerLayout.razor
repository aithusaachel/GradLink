@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject GradLink.Client.Services.ApiClient Api
@inject GradLink.Client.Services.LocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.SignalR.Client
@using GradLink.Shared.DTOs
@implements IAsyncDisposable

<div class="emp">
  <div class="e-shell">
    <div class="e-backdrop @(menuOpen ? "open" : "")" @onclick="CloseMenu" aria-hidden="true"></div>
    <aside class="e-side @(menuOpen ? "open" : "")">
      <a class="e-logo" href="/employer/dashboard"><span class="e-mark"><i></i></span>GradLink</a>
      <button class="e-close" @onclick="CloseMenu" aria-label="Close navigation menu">×</button>
      <div class="e-eyebrow">Employer workspace</div>
      <nav class="e-nav">
        <NavLink class="e-link" href="/employer/dashboard" Match="NavLinkMatch.All" @onclick="CloseMenu">
          <svg class="ico" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>Overview
        </NavLink>
        <NavLink class="e-link" href="/employer/jobs" @onclick="CloseMenu">
          <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18"/></svg>Posted jobs
        </NavLink>
        <NavLink class="e-link" href="/employer/applicants" @onclick="CloseMenu">
          <svg class="ico" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.5a3.5 3.5 0 010 7M18 14.5c2.2.6 3.5 2.6 3.5 5.5"/></svg>Applicants
          @if (applicantCount > 0)
          {
            <span class="e-badge">@applicantCount</span>
          }
        </NavLink>
      </nav>

      <div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px;">
        <div class="e-tip" style="margin-bottom: 12px;">
          <div class="e-tipicon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/></svg></div>
          <small>Hiring tip</small>
          <h4>Stand out to graduates</h4>
          <p>Jobs with salary ranges get 34% more applications.</p>
        </div>

        <a class="e-account" href="/employer/profile" @onclick="CloseMenu" aria-label="Open company profile">
          <div class="e-avatar">@GetCompanyInitials()</div>
          <div><b>@(string.IsNullOrWhiteSpace(companyName) ? "Company Profile" : companyName)</b><span>Company account</span></div>
          <span class="e-account-arrow" aria-hidden="true">›</span>
        </a>
        <button class="e-ghost" style="width: 100%; text-align: left; padding: 8px 12px; font-size: 13px; color: #ef4444;" @onclick="SignOut">
          Sign out
        </button>
      </div>
    </aside>

    <main class="e-main" @onclick="CloseMenu">
      <header class="e-topbar">
        <button class="e-menu" @onclick="ToggleMenu" @onclick:stopPropagation="true" aria-label="Open employer navigation menu" aria-expanded="@menuOpen">
          <span></span><span></span><span></span>
        </button>

        <button class="e-bell" @onclick="ToggleNotifications" @onclick:stopPropagation="true" aria-label="Notifications" aria-expanded="@notificationsOpen" style="position: relative;">
          <svg class="ico" viewBox="0 0 24 24"><path d="M6 9a6 6 0 0112 0c0 6 2 7 2 7H4s2-1 2-7M10 20a2 2 0 004 0"/></svg>
          @if (unreadCount > 0)
          {
            <span style="position: absolute; top: 6px; right: 6px; width: 8px; height: 8px; background: #ef4444; border-radius: 50%;"></span>
          }
        </button>
        @if (notificationsOpen)
        {
          <div class="e-notifications" role="region" aria-label="Notifications" @onclick:stopPropagation="true">
            <div class="e-notifications-head">
              <strong>Notifications</strong>
              <span>@(unreadCount > 0 ? $"{unreadCount} new" : "All read")</span>
            </div>
            @if (notifications.Count == 0)
            {
              <div style="padding: 16px; text-align: center; font-size: 13px; color: #64748b;">
                No notifications yet.
              </div>
            }
            else
            {
              @foreach (var n in notifications)
              {
                <a href="/employer/applicants" class="e-notification-item" @onclick="CloseMenu">
                  <span class="e-notification-dot" style="opacity: @(n.IsRead ? "0.3" : "1");"></span>
                  <span><b>@n.Message</b><small>@FormatTimeAgo(n.CreatedAt)</small></span>
                </a>
              }
            }
          </div>
        }
      </header>
      <div class="e-content">@Body</div>
    </main>
  </div>
</div>

@code {
  private bool menuOpen;
  private bool notificationsOpen;
  private string companyName = "Company";
  private int applicantCount = 0;
  private List<NotificationDto> notifications = new();
  private int unreadCount => notifications.Count(n => !n.IsRead);
  private HubConnection? hubConnection;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var profile = await Api.GetEmployerProfileAsync();
      if (profile != null && !string.IsNullOrWhiteSpace(profile.CompanyName))
      {
        companyName = profile.CompanyName;
      }

      var stats = await Api.GetDashboardStatsAsync();
      if (stats != null)
      {
        applicantCount = stats.TotalApplicants;
      }

      var notifs = await Api.GetNotificationsAsync();
      if (notifs != null)
      {
        notifications = notifs;
      }

      hubConnection = new HubConnectionBuilder()
        .WithUrl(Api.GetHubUrl("/hubs/notifications"), options =>
        {
          options.AccessTokenProvider = async () => await LocalStorage.GetItemAsync("authToken");
        })
        .WithAutomaticReconnect()
        .Build();

      hubConnection.On<NotificationDto>("ReceiveNotification", (notification) =>
      {
        notifications.Insert(0, notification);
        InvokeAsync(StateHasChanged);
      });

      await hubConnection.StartAsync();
    }
    catch (Exception ex)
    {
      Console.WriteLine($"EmployerLayout init error: {ex.Message}");
    }
  }

  private void ToggleMenu()
  {
    menuOpen = !menuOpen;
    notificationsOpen = false;
  }

  private void CloseMenu()
  {
    menuOpen = false;
    notificationsOpen = false;
  }

  private async Task ToggleNotifications()
  {
    notificationsOpen = !notificationsOpen;
    menuOpen = false;
    if (notificationsOpen && unreadCount > 0)
    {
      try
      {
        await Api.MarkAllNotificationsAsReadAsync();
        foreach (var n in notifications)
        {
          n.IsRead = true;
        }
      }
      catch {}
    }
  }

  private string GetCompanyInitials()
  {
    if (string.IsNullOrWhiteSpace(companyName)) return "CO";
    var parts = companyName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
  }

  private static string FormatTimeAgo(DateTime dt)
  {
    var diff = DateTime.UtcNow - dt;
    if (diff.TotalMinutes < 60) return $"{(int)Math.Max(1, diff.TotalMinutes)}m ago";
    if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
    if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
    return dt.ToString("dd MMM");
  }

  private async Task SignOut()
  {
    await LocalStorage.RemoveItemAsync("authToken");
    ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
    Navigation.NavigateTo("/login");
  }

  public async ValueTask DisposeAsync()
  {
    if (hubConnection is not null)
    {
      await hubConnection.DisposeAsync();
    }
  }
}
