@inherits LayoutComponentBase

<div class="emp">
  <div class="e-shell">
    <aside class="e-side">
      <a class="e-logo" href="/employer/dashboard"><span class="e-mark"><i></i></span>Gradly</a>
      <div class="e-eyebrow">Employer workspace</div>
      <nav class="e-nav">
        <NavLink class="e-link" href="/employer/dashboard" Match="NavLinkMatch.All">
          <svg class="ico" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>Overview
        </NavLink>
        <NavLink class="e-link" href="/employer/jobs">
          <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18"/></svg>Posted jobs
        </NavLink>
        <NavLink class="e-link" href="/employer/applicants">
          <svg class="ico" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.5a3.5 3.5 0 010 7M18 14.5c2.2.6 3.5 2.6 3.5 5.5"/></svg>Applicants<span class="e-badge">12</span>
        </NavLink>
        <NavLink class="e-link" href="/employer/profile">
          <svg class="ico" viewBox="0 0 24 24"><path d="M5 21V4a1 1 0 011-1h9a1 1 0 011 1v17M16 9h3a1 1 0 011 1v11M3 21h18M9 8h3M9 12h3M9 16h3"/></svg>Company profile
        </NavLink>
      </nav>

      <div class="e-tip">
        <div class="e-tipicon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/></svg></div>
        <small>Hiring tip</small>
        <h4>Stand out to graduates</h4>
        <p>Jobs with salary ranges get 34% more applications.</p>
      </div>
      <div class="e-account">
        <div class="e-avatar">NL</div>
        <div><b>Northstar Labs</b><span>Company account</span></div>
        <button aria-label="Account menu">•••</button>
      </div>
    </aside>

    <main class="e-main">
      <header class="e-topbar">
        <div class="e-toggle"><button>Graduate</button><button class="on">Employer</button></div>
        <button class="e-bell" aria-label="Notifications">
          <svg class="ico" viewBox="0 0 24 24"><path d="M6 9a6 6 0 0112 0c0 6 2 7 2 7H4s2-1 2-7M10 20a2 2 0 004 0"/></svg>
        </button>
      </header>
      <div class="e-content">@Body</div>
    </main>
  </div>
</div>
