@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
@using GradLink.Shared.DTOs
@inject GradLink.Client.Services.LocalStorageService LocalStorage
@inject GradLink.Client.Services.ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<a href="#main-content" class="skip-to-main-link">Skip to main content</a>

<div class="layout-shell">
    <!-- Backdrop Overlay for Mobile Navigation Drawer -->
    <div class="sidebar-backdrop @(_isMobileMenuOpen ? "active" : "")" @onclick="CloseMobileMenu" aria-hidden="true"></div>

    <!-- Left Sidebar / Mobile Drawer -->
    <aside class="sidebar @(_isMobileMenuOpen ? "mobile-open" : "")" role="navigation" aria-label="Main Navigation">
        <div>
            <!-- Brand Logo & Mobile Close -->
            <div class="brand-row">
                <a href="/graduate/dashboard" class="brand-link" @onclick="CloseMobileMenu">
                    <div class="brand-icon">
                        <div class="brand-icon-inner"></div>
                    </div>
                    <span class="brand-name">GradLink</span>
                </a>

                <button class="mobile-close-btn" @onclick="CloseMobileMenu" aria-label="Close menu">
                    <Icon Name="x" Size="20" />
                </button>
            </div>

            <!-- Workspace Section -->
            <div class="nav-section">
                <div class="nav-section-title">
                    @(IsEmployer ? "EMPLOYER WORKSPACE" : "GRADUATE WORKSPACE")
                </div>

                <nav class="nav-list">
                    @if (IsEmployer)
                    {
                        <a href="/employer/dashboard" class="nav-item @(IsActive("/employer/dashboard") ? "active" : "")" @onclick="CloseMobileMenu">
                            <Icon Name="home" Size="18" />
                            <span>Dashboard</span>
                        </a>
                        <a href="/employer/jobs" class="nav-item @(IsActive("/employer/jobs") ? "active" : "")" @onclick="CloseMobileMenu">
                            <Icon Name="plus" Size="18" />
                            <span>Post a job</span>
                        </a>
                        <a href="/employer/profile" class="nav-item @(IsActive("/employer/profile") ? "active" : "")" @onclick="CloseMobileMenu">
                            <Icon Name="building" Size="18" />
                            <span>Company profile</span>
                        </a>
                    }
                    else
                    {
                        <a href="/graduate/dashboard" class="nav-item @(IsActive("/graduate/dashboard") ? "active" : "")" @onclick="CloseMobileMenu">
                            <Icon Name="home" Size="18" />
                            <span>Overview</span>
                        </a>
                        <a href="/graduate/jobs" class="nav-item @(IsActive("/graduate/jobs") ? "active" : "")" @onclick="CloseMobileMenu">
                            <Icon Name="search" Size="18" />
                            <span>Discover jobs</span>
                        </a>
                        <a href="/graduate/applications" class="nav-item @(IsActive("/graduate/applications") ? "active" : "")" @onclick="CloseMobileMenu">
                            <Icon Name="bag" Size="18" />
                            <span>My applications</span>
                            <span class="nav-badge">@(_stats?.TotalApplications > 0 ? _stats.TotalApplications : 4)</span>
                        </a>
                    }
                </nav>
            </div>
        </div>

        <!-- Sidebar Bottom Area -->
        <div class="sidebar-bottom">
            @if (!IsEmployer)
            {
                <!-- Profile Strength Card -->
                <div class="strength-card">
                    <div class="strength-badge">
                        <Icon Name="sparkles" Size="14" />
                    </div>
                    <div class="strength-tag">PROFILE STRENGTH</div>
                    <div class="strength-title">You're almost there</div>
                    <div class="strength-desc">Add two projects to reach 100%.</div>
                    <div class="strength-progress-bg" role="progressbar" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100">
                        <div class="strength-progress-fill" style="width: 72%;"></div>
                    </div>
                </div>
            }

            <!-- User Profile Footer -->
            <div class="user-footer" @onclick="ToggleUserMenu" @onkeydown="HandleUserFooterKeyDown" role="button" tabindex="0" aria-label="User Options">
                <div class="user-avatar">
                    @GetUserInitials()
                </div>
                <div class="user-info">
                    <div class="user-name">@GetDisplayName()</div>
                    <div class="user-role">@GetUserSubtitle()</div>
                </div>
                <button class="user-menu-btn" title="Options" aria-label="Open user options menu">
                    <Icon Name="dots" Size="16" />
                </button>
            </div>

            @if (_showUserMenu)
            {
                <div class="user-dropdown-menu">
                    <a href="@(IsEmployer ? "/employer/profile" : "/graduate/profile")" class="user-dropdown-item" @onclick="CloseMobileMenu">
                        <Icon Name="user" Size="16" />
                        <span>View profile</span>
                    </a>
                    <button class="user-dropdown-item color-danger" @onclick="SignOut">
                        <Icon Name="log-out" Size="16" />
                        <span>Sign out</span>
                    </button>
                </div>
            }
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
        <!-- Top App Bar -->
        <header class="top-bar">
            <!-- Left Side: Mobile Hamburger Button & Brand -->
            <div class="top-bar-left">
                <button class="mobile-hamburger-btn" @onclick="ToggleMobileMenu" aria-label="Open navigation menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <a href="/graduate/dashboard" class="mobile-brand-link">
                    <span class="brand-name">GradLink</span>
                </a>
            </div>

            <!-- Right Side: Actions -->
            <div class="top-bar-actions">
                <!-- Role Switcher Segmented Control -->
                <div class="role-switcher" role="tablist" aria-label="Role Switcher">
                    <a href="/graduate/dashboard" class="role-btn @(!IsEmployer ? "active" : "")" role="tab" aria-selected="@(!IsEmployer ? "true" : "false")">Graduate</a>
                    <a href="/employer/dashboard" class="role-btn @(IsEmployer ? "active" : "")" role="tab" aria-selected="@(IsEmployer ? "true" : "false")">Employer</a>
                </div>

                <!-- Notifications Dropdown Trigger -->
                <div class="notification-container">
                    <button class="notification-btn" @onclick="ToggleNotifications" title="Notifications" aria-label="Notifications, @_unreadCount unread">
                        <Icon Name="bell" Size="18" />
                        @if (_unreadCount > 0)
                        {
                            <span class="notification-indicator"></span>
                        }
                    </button>

                    @if (_showNotifications)
                    {
                        <div class="notification-popover" role="region" aria-label="Notifications">
                            <div class="notification-popover-header">
                                <span class="notification-popover-title">Notifications</span>
                                @if (_hubConnection?.State == HubConnectionState.Connected)
                                {
                                    <span class="hub-connected-dot" title="Connected to Real-time API"></span>
                                }
                            </div>
                            <div class="notification-list hide-scrollbar">
                                @if (_notifications.Count == 0)
                                {
                                    <div class="notification-empty">No notifications yet.</div>
                                }
                                else
                                {
                                    @foreach (var n in _notifications)
                                    {
                                        <div class="notification-item @(n.IsRead ? "read" : "unread")">
                                            <div class="notification-item-icon">
                                                <Icon Name="bell" Size="13" />
                                            </div>
                                            <div class="notification-item-body">
                                                <div class="notification-item-message">@n.Message</div>
                                                <div class="notification-item-time">@n.CreatedAt.ToString("MMM dd, h:mm tt")</div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Page Body Content -->
        <main id="main-content" class="page-content">
            @Body
        </main>
    </div>
</div>

<style>
    /* Accessibility Skip Link */
    .skip-to-main-link {
        position: absolute;
        top: -100px;
        left: 16px;
        background: #4F46E5;
        color: #FFFFFF;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        z-index: 9999;
        transition: top 0.2s ease;
    }
    .skip-to-main-link:focus {
        top: 16px;
    }

    .layout-shell {
        display: flex;
        min-height: 100vh;
        background-color: #F8F9FB;
        color: #121316;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
    }

    /* Mobile Backdrop */
    .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(17, 24, 39, 0.4);
        backdrop-filter: blur(4px);
        z-index: 35;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sidebar-backdrop.active {
        opacity: 1;
        pointer-events: auto;
    }

    /* Sidebar */
    .sidebar {
        width: 256px;
        background-color: #FFFFFF;
        border-right: 1px solid #ECEEF2;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 24px 16px 20px 16px;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 40;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .brand-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 10px 24px 10px;
    }
    .brand-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
    }
    .brand-icon {
        width: 32px;
        height: 32px;
        background: #111827;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .brand-icon-inner {
        width: 14px;
        height: 6px;
        background: #D4F938;
        border-radius: 3px;
        box-shadow: 0 0 6px rgba(212, 249, 56, 0.6);
    }
    .brand-name {
        font-size: 19px;
        font-weight: 800;
        color: #111827;
        letter-spacing: -0.02em;
    }

    .mobile-close-btn {
        display: none;
        background: none;
        border: none;
        color: #6B7280;
        cursor: pointer;
        padding: 4px;
        border-radius: 8px;
    }

    .nav-section {
        margin-top: 8px;
    }
    .nav-section-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #9CA3AF;
        padding: 0 12px;
        margin-bottom: 16px;
    }
    .nav-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        color: #4B5563;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        min-height: 48px;
    }
    .nav-item:hover {
        background-color: #F3F4F6;
        color: #111827;
    }
    .nav-item:active {
        transform: scale(0.98);
    }
    .nav-item.active {
        background-color: #FFFFFF;
        color: #4F46E5;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
        border: 1px solid #ECEEF2;
    }
    .nav-badge {
        margin-left: auto;
        font-size: 12px;
        font-weight: 600;
        color: #4F46E5;
        background-color: #EEF2FF;
