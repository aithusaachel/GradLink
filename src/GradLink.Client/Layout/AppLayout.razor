</style>

@code {
    private bool IsEmployer => Navigation.Uri.Contains("/employer", StringComparison.OrdinalIgnoreCase);

    private bool IsActive(string href)
    {
        var current = Navigation.Uri;
        return current.Contains(href, StringComparison.OrdinalIgnoreCase);
    }

    private HubConnection? _hubConnection;
    private List<NotificationDto> _notifications = new();
    private int _unreadCount => _notifications.Count(n => !n.IsRead);
    private bool _showNotifications = false;
    private bool _showUserMenu = false;

    private GraduateProfileDto? _profile;
    private DashboardStatsDto? _stats;

    protected override async Task OnInitializedAsync()
    {
        // Load initial profile & stats
        try
        {
            if (!IsEmployer)
            {
                _profile = await Api.GetGraduateProfileAsync();
                _stats = await Api.GetDashboardStatsAsync();
            }
        }
        catch {}

        // Mock existing notification for visual fidelity
        _notifications.Add(new NotificationDto 
        { 
            Message = "Your application for Junior Product Designer has been shortlisted.", 
            CreatedAt = DateTime.Now.AddHours(-1), 
            IsRead = false 
        });
        _notifications.Add(new NotificationDto 
        { 
            Message = "Aperture viewed your graduate profile.", 
            CreatedAt = DateTime.Now.AddDays(-1), 
            IsRead = true 
        });

        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl("http://localhost:5150/hubs/notifications", options => 
                {
                    options.AccessTokenProvider = async () => await LocalStorage.GetItemAsync("authToken");
                })
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<NotificationDto>("ReceiveNotification", (notification) =>
            {
                _notifications.Insert(0, notification);
                InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR Error: {ex.Message}");
        }
    }

    private string GetDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(_profile?.FullName))
            return _profile.FullName;
        return "Alex Morgan";
    }

    private string GetUserSubtitle()
    {
        if (!string.IsNullOrWhiteSpace(_profile?.Degree))
            return _profile.Degree;
        return "Design graduate";
    }

    private string GetUserInitials()
    {
        var name = GetDisplayName();
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        if (parts.Length == 1 && parts[0].Length > 0)
            return parts[0][0].ToString().ToUpper();
        return "AM";
    }

    private void ToggleNotifications()
    {
        _showNotifications = !_showNotifications;
        _showUserMenu = false;
        if (_showNotifications)
        {
            foreach (var n in _notifications)
            {
                n.IsRead = true;
            }
        }
    }

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
        _showNotifications = false;
    }

    private async Task SignOut()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
        Navigation.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
